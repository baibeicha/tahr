{
  "id": "s3-viewer",
  "name": "S3 Object Storage Explorer",
  "version": "1.0.0",
  "author": "Tahr Team",
  "description": "Object storage browser compatible with AWS S3, MinIO, Cloudflare R2, and Google Cloud Storage featuring bucket trees, file preview, and upload",
  "tool_windows": [
    {
      "id": "s3-viewer-panel",
      "title": "S3 Storage",
      "icon": "[S3]",
      "position": "left"
    }
  ],
  "commands": [
    {
      "id": "s3-viewer.browseBuckets",
      "title": "S3: Browse Storage Buckets"
    },
    {
      "id": "s3-viewer.previewObject",
      "title": "S3: Preview / Download Object"
    },
    {
      "id": "s3-viewer.uploadFile",
      "title": "S3: Upload File to Bucket"
    },
    {
      "id": "s3-viewer.deleteObject",
      "title": "S3: Delete Object"
    }
  ],
  "capabilities": [
    "network:client",
    "fs:read",
    "fs:write"
  ],
  "settings": {
    "default_endpoint": {
      "type": "string",
      "default": "https://s3.amazonaws.com",
      "description": "S3 compatible service endpoint (e.g. MinIO, Cloudflare R2)"
    },
    "default_region": {
      "type": "string",
      "default": "us-east-1",
      "description": "Default AWS region"
    },
    "use_path_style": {
      "type": "bool",
      "default": false,
      "description": "Use path-style bucket addressing (required for MinIO and local endpoints)"
    }
  }
}
