{
  "id": "tahr-clangd",
  "name": "C / C++ Language Support",
  "version": "1.0.0",
  "type": "language",
  "author": "Tahr Team",
  "description": "C and C++ language support with clangd LSP, CMake/Makefile integration, and lldb-dap debugging",
  "capabilities": [
    "fs:read",
    "process:exec"
  ],
  "toolchain": {
    "name": "C/C++"
  },
  "languages": [
    {
      "id": "c_cpp",
      "name": "C/C++",
      "extensions": [
        ".c",
        ".h",
        ".cpp",
        ".cc",
        ".cxx",
        ".hpp",
        ".hxx"
      ],
      "filenames": [
        "CMakeLists.txt",
        "Makefile",
        "compile_commands.json"
      ],
      "comment_token": "//",
      "build_cmd": "cmake",
      "build_args": [
        "--build",
        "build"
      ],
      "run_cmd": "./build/app"
    }
  ],
  "testing": {
    "id": "c_cpp",
    "name": "CTest / C++ Tests",
    "framework": "ctest",
    "languages": [
      "c_cpp",
      "c",
      "cpp"
    ],
    "extensions": [
      ".c",
      ".cpp",
      ".cc",
      ".cxx"
    ],
    "test_patterns": [
      "*_test.cpp",
      "*_test.cc",
      "test_*.cpp",
      "test_*.cc"
    ],
    "command": "ctest",
    "args": [
      "--output-on-failure",
      "-V"
    ],
    "run_single_args": [
      "-R",
      "^{{test}}$",
      "--output-on-failure",
      "-V"
    ],
    "run_package_args": [
      "--test-dir",
      "{{package}}",
      "--output-on-failure",
      "-V"
    ],
    "run_all_args": [
      "--output-on-failure",
      "-V"
    ],
    "discovery": {
      "file_patterns": [
        "*_test.cpp",
        "*_test.cc",
        "test_*.cpp",
        "test_*.cc"
      ],
      "extract_regexes": [
        "TEST(?:_F|_P)?\\s*\\(\\s*([A-Za-z0-9_]+)\\s*,\\s*([A-Za-z0-9_]+)\\s*\\)"
      ],
      "package_root_markers": [
        "CMakeLists.txt",
        "Makefile"
      ]
    },
    "output_parsing": {
      "pass_pattern": "Test\\s+#\\d+:\\s+(\\S+)\\s+\\.+?\\s*Passed(?:\\s+([0-9.]+\\s*(?:sec|s)))?",
      "fail_pattern": "Test\\s+#\\d+:\\s+(\\S+)\\s+\\.+?\\*+Failed(?:\\s+([0-9.]+\\s*(?:sec|s)))?",
      "skip_pattern": "Test\\s+#\\d+:\\s+(\\S+)\\s+\\.+?\\*+Skipped",
      "traceback_start": "^(?:.*?Failure|.*?:\\d+:\\s+Failure|Valgrind error:)",
      "traceback_end": "^\\s*(?:\\d+/\\d+\\s+Test\\s+#|\\d+% tests passed)"
    }
  },
  "lsp": {
    "server_name": "clangd",
    "command": "clangd",
    "args": [
      "--background-index",
      "--clang-tidy",
      "--completion-style=detailed"
    ],
    "root_markers": [
      "compile_commands.json",
      "CMakeLists.txt",
      "Makefile",
      ".git"
    ],
    "install_cmd": "winget install LLVM.LLVM || brew install llvm"
  },
  "dap": {
    "adapter_name": "lldb-dap",
    "command": "lldb-dap",
    "args": []
  },
  "launchTemplates": [
    {
      "name": "CMake: Build & Run",
      "type": "c_cpp",
      "request": "launch",
      "target": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "all"
      ]
    },
    {
      "name": "Make: Build All",
      "type": "c_cpp",
      "request": "launch",
      "target": "make",
      "args": [
        "all"
      ]
    }
  ],
  "project_templates": [
    {
      "id": "c-app",
      "name": "C (Standard Application)",
      "description": "C application starter with main.c, Makefile, and .gitignore",
      "category": "C/C++",
      "default_module": "{{.ProjectName}}",
      "files": [
        {
          "path": "main.c",
          "content": "#include <stdio.h>\n\nint main(int argc, char *argv[]) {\n    printf(\"Hello from {{.ProjectName}}!\\n\");\n    return 0;\n}\n"
        },
        {
          "path": "Makefile",
          "content": "CC ?= gcc\nCFLAGS ?= -Wall -Wextra -O2\n\nTARGET = {{.ProjectName}}\nSRCS = main.c\n\nall: $(TARGET)\n\n$(TARGET): $(SRCS)\n\t$(CC) $(CFLAGS) -o $(TARGET) $(SRCS)\n\nclean:\n\trm -f $(TARGET)\n"
        },
        {
          "path": ".gitignore",
          "content": "*.o\n*.exe\nbuild/\n{{.ProjectName}}\n"
        },
        {
          "path": "README.md",
          "content": "# {{.ProjectName}}\n\nA C project.\n"
        }
      ]
    }
  ],
  "sdk_autodetect": {
    "binaries": [
      "clangd",
      "clang",
      "clang++",
      "gcc",
      "g++",
      "cmake",
      "make",
      "ninja",
      "lldb-dap"
    ],
    "windows_paths": [
      "C:\\Program Files\\LLVM\\bin",
      "C:\\msys64\\mingw64\\bin",
      "C:\\msys64\\ucrt64\\bin",
      "C:\\MinGW\\bin"
    ],
    "unix_paths": [
      "/usr/bin/clangd",
      "/usr/local/bin/clangd",
      "/opt/homebrew/opt/llvm/bin/clangd",
      "/usr/bin/gcc"
    ]
  },
  "localizations": [
    {
      "locale": "en",
      "name": "English",
      "file": "locales/en.json"
    },
    {
      "locale": "ru",
      "name": "Русский",
      "file": "locales/ru.json"
    },
    {
      "locale": "zh",
      "name": "简体中文",
      "file": "locales/zh.json"
    },
    {
      "locale": "es",
      "name": "Español",
      "file": "locales/es.json"
    }
  ]
}