{
  "id": "tahr-python",
  "name": "Python Language Support",
  "version": "1.0.0",
  "type": "language",
  "author": "Tahr Team",
  "description": "Python language support with Pyright LSP, debugpy DAP debugger, pytest integration, virtualenv autodetection",
  "capabilities": [
    "fs:read",
    "process:exec"
  ],
  "toolchain": {
    "name": "Python",
    "env_markers": [
      ".venv",
      "venv",
      "env"
    ],
    "env_variable": "VIRTUAL_ENV",
    "env_suffix": " (.venv)"
  },
  "languages": [
    {
      "id": "python",
      "name": "Python",
      "extensions": [
        ".py",
        ".pyw",
        ".pyi"
      ],
      "filenames": [
        "requirements.txt",
        "pyproject.toml",
        "Pipfile",
        "setup.py"
      ],
      "comment_token": "#",
      "build_cmd": "python",
      "build_args": [
        "-m",
        "py_compile"
      ],
      "run_cmd": "python",
      "run_args": [
        "main.py"
      ],
      "test_cmd": "pytest",
      "test_args": [
        "-v"
      ],
      "test_pattern": "test_*.py",
      "install_cmd": "pip install pyright debugpy pytest ruff"
    }
  ],
  "testing": {
    "id": "python",
    "name": "Pytest",
    "framework": "pytest",
    "languages": [
      "python"
    ],
    "extensions": [
      ".py"
    ],
    "test_patterns": [
      "test_*.py",
      "*_test.py"
    ],
    "command": "pytest",
    "args": [
      "-v"
    ],
    "run_single_args": [
      "-v",
      "-k",
      "{{test}}",
      "{{file}}"
    ],
    "run_package_args": [
      "-v",
      "{{package}}"
    ],
    "run_all_args": [
      "-v"
    ],
    "discovery": {
      "file_patterns": [
        "test_*.py",
        "*_test.py"
      ],
      "extract_regexes": [
        "def\\s+(test_[A-Za-z0-9_]+)\\s*\\("
      ],
      "package_root_markers": [
        "pyproject.toml",
        "setup.py",
        "requirements.txt"
      ]
    },
    "output_parsing": {
      "pass_pattern": "(?:(\\S+::\\S+|test_\\w+)\\s+PASSED|PASSED\\s+(\\S+))(?:.*?\\(([0-9.]+(?:s|ms))\\))?",
      "fail_pattern": "(?:(\\S+::\\S+|test_\\w+)\\s+FAILED|FAILED\\s+(\\S+))(?:.*?\\(([0-9.]+(?:s|ms))\\))?",
      "skip_pattern": "(?:(\\S+::\\S+|test_\\w+)\\s+SKIPPED|SKIPPED\\s+(\\S+))",
      "traceback_start": "^(?:_{3,}\\s*\\w+\\s*_{3,}|={3,}\\s*FAILURES\\s*={3,}|>\\s+.*|E\\s+.*)",
      "traceback_end": "^={3,}"
    }
  },
  "lsp": {
    "server_name": "pyright",
    "command": "pyright-langserver",
    "args": [
      "--stdio"
    ],
    "root_markers": [
      "pyproject.toml",
      "requirements.txt",
      "setup.py",
      ".git"
    ],
    "install_cmd": "pip install pyright || npm install -g pyright"
  },
  "dap": {
    "adapter_name": "debugpy",
    "command": "python",
    "args": [
      "-m",
      "debugpy.adapter"
    ],
    "install_cmd": "pip install debugpy"
  },
  "launchTemplates": [
    {
      "name": "Python: Run Script",
      "type": "python",
      "request": "launch",
      "target": "main.py"
    },
    {
      "name": "Python: Run Pytest",
      "type": "python",
      "request": "launch",
      "target": "pytest",
      "args": [
        "-v"
      ]
    },
    {
      "name": "Python: Debug Current File",
      "type": "python",
      "request": "debug",
      "target": "${file}"
    }
  ],
  "project_templates": [
    {
      "id": "python-app",
      "name": "Python (Standard Application)",
      "description": "Clean Python project layout with main.py, requirements.txt, and .gitignore",
      "category": "Python",
      "default_module": "{{.ProjectName}}",
      "files": [
        {
          "path": "main.py",
          "content": "def main():\n    print(\"Hello from {{.ProjectName}}!\")\n\nif __name__ == \"__main__\":\n    main()\n"
        },
        {
          "path": "requirements.txt",
          "content": "# Project dependencies\n"
        },
        {
          "path": ".gitignore",
          "content": "__pycache__/\n*.py[cod]\n*$py.class\n.venv/\nenv/\nbuild/\ndist/\n*.egg-info/\n"
        },
        {
          "path": "README.md",
          "content": "# {{.ProjectName}}\n\nA Python application.\n"
        }
      ]
    }
  ],
  "sdk_autodetect": {
    "binaries": [
      "python",
      "python3",
      "py",
      "pyright-langserver",
      "pyright",
      "pytest"
    ],
    "windows_paths": [
      "C:\\Python*",
      "C:\\Program Files\\Python*\\python.exe",
      "%LOCALAPPDATA%\\Programs\\Python\\Python*\\python.exe",
      "%USERPROFILE%\\AppData\\Local\\Microsoft\\WindowsApps\\python.exe"
    ],
    "unix_paths": [
      "/usr/bin/python3",
      "/usr/local/bin/python3",
      "/opt/homebrew/bin/python3",
      "~/.pyenv/shims/python"
    ]
  },
  "localizations": [
    {
      "locale": "en",
      "name": "English",
      "file": "locales/en.json"
    },
    {
      "locale": "ru",
      "name": "Русский",
      "file": "locales/ru.json"
    },
    {
      "locale": "zh",
      "name": "简体中文",
      "file": "locales/zh.json"
    },
    {
      "locale": "es",
      "name": "Español",
      "file": "locales/es.json"
    }
  ]
}