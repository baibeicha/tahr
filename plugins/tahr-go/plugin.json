{
  "id": "tahr-go",
  "name": "Go Language Support",
  "version": "1.0.0",
  "type": "language",
  "author": "Tahr Team",
  "description": "Language Server (gopls), Delve debugger, launch templates and SDK autodetection",
  "capabilities": [
    "fs:read",
    "process:exec"
  ],
  "toolchain": {
    "name": "Go",
    "dynamic_sdk": "go"
  },
  "languages": [
    {
      "id": "go",
      "name": "Go",
      "extensions": [
        ".go"
      ],
      "filenames": [
        "go.mod",
        "go.sum",
        "go.work"
      ],
      "comment_token": "//",
      "build_cmd": "go",
      "build_args": [
        "build",
        "./..."
      ],
      "run_cmd": "go",
      "run_args": [
        "run",
        "."
      ],
      "test_cmd": "go",
      "test_args": [
        "test",
        "-v"
      ],
      "test_pattern": "*_test.go",
      "install_cmd": "go install golang.org/x/tools/gopls@latest"
    }
  ],
  "testing": {
    "id": "go",
    "name": "Go Test",
    "framework": "go test",
    "languages": [
      "go"
    ],
    "extensions": [
      ".go"
    ],
    "test_patterns": [
      "*_test.go"
    ],
    "command": "go",
    "args": [
      "test",
      "-v"
    ],
    "run_single_args": [
      "test",
      "-v",
      "-run",
      "^{{test}}$",
      "{{package}}"
    ],
    "run_package_args": [
      "test",
      "-v",
      "{{package}}"
    ],
    "run_all_args": [
      "test",
      "-v",
      "./..."
    ],
    "discovery": {
      "file_patterns": [
        "*_test.go"
      ],
      "extract_regexes": [
        "func\\s+(Test[A-Za-z0-9_]+)\\s*\\("
      ],
      "package_root_markers": [
        "go.mod",
        "go.work"
      ]
    },
    "output_parsing": {
      "pass_pattern": "--- PASS:\\s+(\\S+)(?:\\s+\\(([0-9.]+(?:s|ms|ns|m))\\))?",
      "fail_pattern": "--- FAIL:\\s+(\\S+)(?:\\s+\\(([0-9.]+(?:s|ms|ns|m))\\))?",
      "skip_pattern": "--- SKIP:\\s+(\\S+)(?:\\s+\\(([0-9.]+(?:s|ms|ns|m))\\))?",
      "traceback_start": "^\\s*(?:[A-Za-z0-9_.-]+_test\\.go:\\d+:|panic:|FAIL)",
      "traceback_end": "^--- (?:PASS|FAIL|SKIP):"
    }
  },
  "lsp": {
    "server_name": "gopls",
    "command": "gopls",
    "args": [],
    "root_markers": [
      "go.mod",
      "go.work",
      ".git"
    ],
    "install_cmd": "go install golang.org/x/tools/gopls@latest"
  },
  "dap": {
    "adapter_name": "delve",
    "command": "dlv",
    "args": [
      "dap"
    ],
    "install_cmd": "go install github.com/go-delve/delve/cmd/dlv@latest"
  },
  "launchTemplates": [
    {
      "name": "Go: Run Package",
      "type": "go",
      "request": "launch",
      "target": ".",
      "env": {
        "CGO_ENABLED": "0"
      },
      "preLaunchTask": "go vet ./..."
    },
    {
      "name": "Go: Debug Test",
      "type": "go",
      "request": "debug",
      "target": ".",
      "args": [
        "-test.v"
      ]
    },
    {
      "name": "Go: Build",
      "type": "go",
      "request": "launch",
      "target": "build",
      "args": [
        "-v",
        "./..."
      ]
    }
  ],
  "project_templates": [
    {
      "id": "go",
      "name": "Go (Standard Module)",
      "description": "Standard Go module with main package, go.mod, and .gitignore",
      "category": "Go",
      "default_module": "example.com/{{.ProjectName}}",
      "files": [
        {
          "path": "go.mod",
          "content": "module {{.ModulePath}}\n\ngo 1.22\n"
        },
        {
          "path": "main.go",
          "content": "package main\n\nimport \"fmt\"\n\nfunc main() {\n\tfmt.Println(\"Hello from {{.ProjectName}}!\")\n}\n"
        },
        {
          "path": ".gitignore",
          "content": "bin/\n*.exe\n*.test\nvendor/\n"
        },
        {
          "path": "README.md",
          "content": "# {{.ProjectName}}\n\nA Go project.\n"
        }
      ]
    },
    {
      "id": "go-cli",
      "name": "Go (CLI Application)",
      "description": "Command-line application layout with cmd/ and internal/ packages",
      "category": "Go",
      "default_module": "example.com/{{.ProjectName}}",
      "files": [
        {
          "path": "go.mod",
          "content": "module {{.ModulePath}}\n\ngo 1.22\n"
        },
        {
          "path": "cmd/{{.ProjectName}}/main.go",
          "content": "package main\n\nimport (\n\t\"flag\"\n\t\"fmt\"\n)\n\nfunc main() {\n\tname := flag.String(\"name\", \"world\", \"name to greet\")\n\tflag.Parse()\n\tfmt.Printf(\"Hello, %s! Welcome to {{.ProjectName}}.\\n\", *name)\n}\n"
        },
        {
          "path": "internal/app/app.go",
          "content": "package app\n\n// Run executes application logic.\nfunc Run() error {\n\treturn nil\n}\n"
        },
        {
          "path": ".gitignore",
          "content": "bin/\n*.exe\n*.test\nvendor/\n"
        },
        {
          "path": "README.md",
          "content": "# {{.ProjectName}} CLI\n\nCommand-line tool built with Go.\n"
        }
      ]
    }
  ],
  "sdk_autodetect": {
    "binaries": [
      "go",
      "gopls",
      "dlv"
    ],
    "windows_paths": [
      "D:\\go\\sdk\\*",
      "C:\\Program Files\\Go\\bin",
      "C:\\Go\\bin",
      "%USERPROFILE%\\go\\bin"
    ],
    "unix_paths": [
      "/usr/local/go/bin",
      "/usr/bin",
      "/opt/homebrew/bin",
      "~/go/bin"
    ]
  },
  "localizations": [
    {
      "locale": "en",
      "name": "English",
      "file": "locales/en.json"
    },
    {
      "locale": "ru",
      "name": "Русский",
      "file": "locales/ru.json"
    },
    {
      "locale": "zh",
      "name": "简体中文",
      "file": "locales/zh.json"
    },
    {
      "locale": "es",
      "name": "Español",
      "file": "locales/es.json"
    }
  ]
}