{
  "id": "tahr-zig",
  "name": "Zig Language Support",
  "version": "1.0.0",
  "type": "language",
  "author": "Tahr Team",
  "description": "Zig language support with ZLS (Zig Language Server), native zig test runner and launch configurations",
  "capabilities": [
    "fs:read",
    "process:exec"
  ],
  "toolchain": {
    "name": "Zig",
    "dynamic_sdk": "zig"
  },
  "localizations": [
    {
      "locale": "en",
      "name": "English",
      "file": "locales/en.json"
    },
    {
      "locale": "ru",
      "name": "Русский",
      "file": "locales/ru.json"
    },
    {
      "locale": "zh",
      "name": "简体中文",
      "file": "locales/zh.json"
    },
    {
      "locale": "es",
      "name": "Español",
      "file": "locales/es.json"
    }
  ],
  "languages": [
    {
      "id": "zig",
      "name": "Zig",
      "extensions": [
        ".zig"
      ],
      "filenames": [
        "build.zig",
        "build.zig.zon"
      ],
      "comment_token": "//",
      "build_cmd": "zig",
      "build_args": [
        "build"
      ],
      "run_cmd": "zig",
      "run_args": [
        "build",
        "run"
      ],
      "test_cmd": "zig",
      "test_args": [
        "build",
        "test"
      ],
      "test_pattern": "*.zig",
      "install_cmd": "scoop install zig zls"
    }
  ],
  "testing": {
    "id": "zig",
    "name": "Zig Test",
    "framework": "zig test",
    "languages": [
      "zig"
    ],
    "extensions": [
      ".zig"
    ],
    "test_patterns": [
      "*.zig"
    ],
    "command": "zig",
    "args": [
      "test"
    ],
    "run_single_args": [
      "test",
      "{{file}}",
      "--test-filter",
      "{{test}}"
    ],
    "run_package_args": [
      "build",
      "test"
    ],
    "run_all_args": [
      "build",
      "test"
    ],
    "discovery": {
      "file_patterns": [
        "*.zig"
      ],
      "extract_regexes": [
        "test\\s+\"([^\"]+)\""
      ],
      "package_root_markers": [
        "build.zig",
        "build.zig.zon"
      ]
    },
    "output_parsing": {
      "pass_pattern": "All\\s+(\\d+)\\s+tests passed",
      "fail_pattern": "(\\d+)/\\d+\\s+test failed",
      "skip_pattern": "(\\d+)\\s+tests skipped",
      "traceback_start": "^(?:.*\\.zig:\\d+:\\d+:|error:)",
      "traceback_end": "^(?:All \\d+ tests passed|\\d+/\\d+ test failed)"
    }
  },
  "lsp": {
    "server_name": "zls",
    "command": "zls",
    "args": [],
    "root_markers": [
      "build.zig",
      "build.zig.zon",
      ".git"
    ],
    "install_cmd": "scoop install zls"
  },
  "dap": {
    "adapter_name": "lldb-dap",
    "command": "lldb-dap",
    "args": []
  },
  "launchTemplates": [
    {
      "name": "Zig: Build and Run",
      "type": "zig",
      "request": "launch",
      "target": "zig",
      "args": [
        "build",
        "run"
      ]
    },
    {
      "name": "Zig: Test Suite",
      "type": "zig",
      "request": "launch",
      "target": "zig",
      "args": [
        "build",
        "test"
      ]
    }
  ],
  "project_templates": [
    {
      "id": "zig-app",
      "name": "Zig (Standard Executable)",
      "description": "Standard Zig project with build.zig and main.zig",
      "category": "Zig",
      "default_module": "{{.ProjectName}}",
      "files": [
        {
          "path": "build.zig",
          "content": "const std = @import(\"std\");\n\npub fn build(b: *std.Build) void {\n    const target = b.standardTargetOptions(.{});\n    const optimize = b.standardOptimizeOption(.{});\n\n    const exe = b.addExecutable(.{\n        .name = \"{{.ProjectName}}\",\n        .root_source_file = b.path(\"src/main.zig\"),\n        .target = target,\n        .optimize = optimize,\n    });\n    b.installArtifact(exe);\n\n    const run_cmd = b.addRunArtifact(exe);\n    const run_step = b.step(\"run\", \"Run the application\");\n    run_step.dependOn(&run_cmd.step);\n\n    const unit_tests = b.addTest(.{\n        .root_source_file = b.path(\"src/main.zig\"),\n        .target = target,\n        .optimize = optimize,\n    });\n    const run_unit_tests = b.addRunArtifact(unit_tests);\n    const test_step = b.step(\"test\", \"Run unit tests\");\n    test_step.dependOn(&run_unit_tests.step);\n}\n"
        },
        {
          "path": "src/main.zig",
          "content": "const std = @import(\"std\");\n\npub fn main() !void {\n    std.debug.print(\"Hello from {{.ProjectName}}!\\n\", .{});\n}\n\ntest \"simple test\" {\n    try std.testing.expectEqual(10, 5 + 5);\n}\n"
        },
        {
          "path": ".gitignore",
          "content": ".zig-cache/\nzig-out/\n"
        },
        {
          "path": "README.md",
          "content": "# {{.ProjectName}}\n\nA Zig project.\n"
        }
      ]
    }
  ],
  "sdk_autodetect": {
    "binaries": [
      "zig",
      "zls"
    ],
    "windows_paths": [
      "C:\\tools\\zig*",
      "C:\\Program Files\\Zig\\*\\bin",
      "%USERPROFILE%\\.zig\\bin"
    ],
    "unix_paths": [
      "/usr/bin",
      "/usr/local/bin",
      "/opt/homebrew/bin"
    ]
  }
}
